# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local backups and patches
*~
*.bak
*.backup
*.orig
*.rej
*.patch
*.diff

# temporary screenshots and test exports
screenshots/
test-exports/
playwright-report/
test-results/
*.screenshot.*
*screenshot*.png
*screenshot*.jpg
*screenshot*.jpeg
*screenshot*.webp
*test-export*.png
*test-export*.jpg
*test-export*.jpeg
*test-export*.webp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local event flyer uploads stay out of git.
public/event-media/flyers/

# Generated fallback thumbnails stay local until asset storage is finalized.
public/event-media/fallback/*.webp
