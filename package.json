{
  "name": "celebration-atlas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:flyers && next build",
    "start": "next start",
    "lint": "eslint",
    "atlas:check": "npm run lint && npm run build",
    "atlas:status": "git status --short",
    "atlas:next": "node scripts/atlas-next-task.mjs",
    "atlas:prompt": "node scripts/atlas-codex-prompt.mjs",
    "atlas:complete": "node scripts/atlas-complete-task.mjs",
    "atlas:complete:dry": "node scripts/atlas-complete-task.mjs --dry-run",
    "atlas:handoff": "node scripts/atlas-handoff.mjs",
    "atlas:runbook": "node scripts/atlas-runbook.mjs",
    "atlas:doctor": "node scripts/atlas-doctor.mjs",
    "atlas:generate-thumbnails": "node --experimental-strip-types scripts/generate-event-thumbnails.ts",
    "validate:official-urls": "node --experimental-strip-types scripts/validate-official-url-resolver.ts",
    "validate:flyers": "node --experimental-strip-types scripts/validate-flyers.ts",
    "validate:flyers:local": "node --experimental-strip-types scripts/validate-flyers.ts --local",
    "test:visual-install": "playwright install chromium",
    "test:visual-smoke": "node scripts/visual-smoke.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "maplibre-gl": "5.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
